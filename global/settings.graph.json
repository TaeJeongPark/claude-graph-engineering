{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/graph/hooks/graph-context.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
